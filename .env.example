# CloudStack API connection.
# Leave these empty to stay in mock mode (built-in sample data).
CLOUDSTACK_URL=https://cloud.example.com
CLOUDSTACK_API_KEY=
CLOUDSTACK_SECRET_KEY=
CLOUDSTACK_VERIFY_TLS=true
CLOUDSTACK_TIMEOUT=30

# true = use built-in fixtures, no network calls.
# Defaults to true when the three connection variables are incomplete.
CLOUDSTACK_MOCK=true

# Write tools are OFF by default. Even when enabled, every write call still
# needs confirm=true. Keep this false unless you really need it.
CLOUDSTACK_AGENT_ALLOW_WRITE=false

# LangGraph model, as provider:model. Install the matching provider package.
# Examples: openai:gpt-4o-mini, anthropic:claude-3-5-sonnet-latest
CLOUDSTACK_AGENT_MODEL=openai:gpt-4o-mini
